# =============================================================================
# HolcemLK Banker — Environment Template
# =============================================================================
# Copy this file to .env and fill in your local values.
# .env is gitignored — never commit real secrets to version control.
# =============================================================================

# ---- Database: DataEntry (read-only) ----
DATAENTRY_DB_HOST=localhost
DATAENTRY_DB_NAME=holcemlk_banker_dataentry
DATAENTRY_DB_USER=app_dataentry_ro
DATAENTRY_DB_PASSWORD=<set-locally>

# ---- Database: Images (read-write) ----
IMAGES_DB_HOST=localhost
IMAGES_DB_NAME=holcemlk_banker_images
IMAGES_DB_USER=app_images_rw
IMAGES_DB_PASSWORD=<set-locally>

# ---- Redis ----
REDIS_URL=redis://localhost:6379

# ---- TLS Certificate Paths (for HTTPS server) ----
TLS_CERT_PATH=./config/server-cert.pem
TLS_KEY_PATH=./config/server-key.pem

# ---- Encryption Keys (production values via OS secret store) ----
AES_256_KEY=<set-locally>
AES_256_IV=<set-locally>
